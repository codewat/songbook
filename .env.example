# Optional: Pre-configure Firebase Cloud Sync for your church deployment.
# If left empty, users can still use the app 100% offline or paste Firebase config inside Settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_CHURCH_NAME=Church Worship Team
# 'firestore' (100% free Spark plan, zero CORS setup) or 'storage' (Firebase Storage bucket)
VITE_FIREBASE_FILE_STORAGE_MODE=firestore
